{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "backstage": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "imagePullSecrets",
        "egress"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "ports"
            ],
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "ipBlock"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "ipBlock": {
                      "type": "object",
                      "required": [
                        "cidr"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "cidr": {
                          "type": "string",
                          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])$"
                        }
                      }
                    }
                  }
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "protocol",
                    "port"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "protocol": {
                      "const": "TCP"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "image": {
                "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
